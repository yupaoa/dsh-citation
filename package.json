{
  "name": "dsh-citation",
  "version": "0.1.0",
  "description": "划选回复右键「添加到对话」：引用以不可编辑的胶囊进入输入框，悬停查看原文，发送时展开为模型可读的「第几轮哪一段」引用块。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "citation",
    "quote",
    "cordis"
  ],
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yupaoa/dsh-citation.git"
  },
  "homepage": "https://github.com/yupaoa/dsh-citation#readme",
  "bugs": {
    "url": "https://github.com/yupaoa/dsh-citation/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0"
  }
}
